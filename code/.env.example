# Copy to the repository root as `.env` (never commit it).
# Model provider: gemini (anthropic is reserved; its transport is not built).
DELETION_AUDIT_PROVIDER=gemini
# Key for the chosen provider.
GEMINI_API_KEY=
# Optional model overrides (defaults for gemini shown).
DELETION_AUDIT_INTENT_MODEL=gemini-3.5-flash-lite
DELETION_AUDIT_VISUAL_MODEL=gemini-3.5-flash
# Optional per-call timeouts in seconds and the pause between live calls.
DELETION_AUDIT_INTENT_TIMEOUT=60
DELETION_AUDIT_VISUAL_TIMEOUT=180
DELETION_AUDIT_MIN_INTERVAL=4
